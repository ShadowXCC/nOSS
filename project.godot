; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="nOSS"
config/description="Bring your own car. The platform decides how it drives."
config/version="0.12.10"
run/main_scene="res://game/app/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="nOSS"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.07, 0.07, 0.09, 1)
boot_splash/image="res://content/branding/splash.png"
config/icon="res://content/branding/icon.png"
config/windows_native_icon="res://content/branding/icon.ico"
config/macos_native_icon="res://content/branding/icon.icns"

[autoload]

Settings="*res://game/app/settings.gd"
Net="*res://game/net/net.gd"
Game="*res://game/app/game.gd"
Discord="*res://game/app/discord.gd"
Devices="*res://game/players/devices.gd"
Players="*res://game/players/players.gd"
Narrator="*res://game/app/narrator.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

style_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
style_mip_bias={
"type": "float",
"value": 0.0
}
style_saturation={
"type": "float",
"value": 1.0
}
env_wetness={
"type": "float",
"value": 0.0
}
env_snow={
"type": "float",
"value": 0.0
}
env_night={
"type": "float",
"value": 0.0
}
env_flicker={
"type": "float",
"value": 0.0
}
