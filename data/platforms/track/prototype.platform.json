{
  "schema": "noss.platform/1",
  "id": "official.track.prototype",
  "name": "Prototype",
  "version": "0.1.0",
  "family": "car",
  "modes": ["track"],
  "accepts_families": ["car"],

  "layout": {
    "drive": "rwd",
    "axles": [
      { "steer": true, "driven": false, "wheels": 2 },
      { "steer": false, "driven": true, "wheels": 2 }
    ]
  },

  "geometry": {
    "wheelbase_m": { "ref": 2.80, "min": 2.50, "max": 3.10 },
    "track_m": { "ref": 1.70, "min": 1.55, "max": 1.85 },
    "ride_height_m": { "ref": 0.06, "min": 0.04, "max": 0.09 },
    "wheel_radius_m": { "ref": 0.34, "min": 0.31, "max": 0.37 },
    "envelope_m": { "length": [4.3, 5.0], "width": [1.85, 2.05], "height": [0.95, 1.20] }
  },

  "mass": {
    "kg": 1000,
    "front_weight": 0.45,
    "cog_height_over_track": 0.18,
    "yaw_dynamic_index": 0.90
  },

  "engine": {
    "torque_curve_nm": [[2000, 330], [4000, 480], [6000, 560], [7500, 575], [8500, 539], [9200, 480]],
    "idle_rpm": 1500,
    "redline_rpm": 9000,
    "limiter_rpm": 9200,
    "inertia_kgm2": 0.12,
    "engine_brake_nm": 80
  },
  "gearbox": {
    "type": "sequential",
    "ratios": [2.90, 2.15, 1.70, 1.40, 1.18, 1.02],
    "reverse": 3.0,
    "final_drive": 3.40,
    "shift_time_s": 0.05
  },
  "differential": { "type": "lsd_clutch", "preload_nm": 100, "power_lock": 0.50, "coast_lock": 0.30 },
  "brakes": { "max_torque_nm": 9000, "bias_front": 0.58 },
  "suspension": {
    "front": { "freq_hz": 3.6, "damping_bump": 0.60, "damping_rebound": 0.80, "travel_m": 0.05 },
    "rear": { "freq_hz": 3.4, "damping_bump": 0.60, "damping_rebound": 0.80, "travel_m": 0.06 },
    "roll_gradient_deg_per_g": 0.5,
    "roll_stiffness_front_share": 0.52
  },
  "steering": { "max_road_angle_deg": 20, "wheel_rotation_deg": 360 },
  "aero": { "cd_a": 0.95, "cl_a_front": -1.50, "cl_a_rear": -2.00, "slipstream": true },
  "tires": {
    "model": "pacejka_lite",
    "compound": "slick",
    "mu_peak": 1.65,
    "load_sensitivity": 0.12,
    "peak_slip_ratio": 0.09,
    "peak_slip_angle_deg": 6.5,
    "relaxation_length_m": 0.20,
    "rolling_resistance": 0.012,
    "wear": false,
    "temperature": false
  },

  "assists_allowed": ["abs", "tcs", "stability", "auto_gearbox", "auto_clutch", "steer_aid", "racing_line"],
  "damage": { "cosmetic": true, "mechanical": ["alignment", "aero", "engine", "suspension"] },

  "tunable": {
    "gearbox.final_drive": { "min": 3.00, "max": 3.90, "step": 0.05 },
    "gearbox.ratios": { "mode": "per_gear", "min": 0.80, "max": 3.40, "step": 0.01 },
    "brakes.bias_front": { "min": 0.50, "max": 0.66, "step": 0.01 },
    "suspension.front.freq_hz": { "min": 3.2, "max": 4.2, "step": 0.05 },
    "suspension.rear.freq_hz": { "min": 3.0, "max": 4.0, "step": 0.05 },
    "suspension.roll_stiffness_front_share": { "min": 0.44, "max": 0.60, "step": 0.01 },
    "aero.cl_a_rear": { "min": -2.40, "max": -1.60, "step": 0.05 },
    "differential.power_lock": { "min": 0.30, "max": 0.80, "step": 0.05 }
  },

  "ffb": { "reference_rack_nm": 11.0 }
}
