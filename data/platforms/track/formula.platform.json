{
  "schema": "noss.platform/1",
  "id": "official.track.formula",
  "name": "Formula",
  "version": "0.1.0",
  "family": "open",
  "modes": ["track"],
  "accepts_families": ["open"],

  "layout": {
    "drive": "rwd",
    "axles": [
      { "steer": true, "driven": false, "wheels": 2 },
      { "steer": false, "driven": true, "wheels": 2 }
    ]
  },

  "geometry": {
    "wheelbase_m": { "ref": 2.90, "min": 2.55, "max": 3.30 },
    "track_m": { "ref": 1.60, "min": 1.45, "max": 1.78 },
    "ride_height_m": { "ref": 0.04, "min": 0.03, "max": 0.07 },
    "wheel_radius_m": { "ref": 0.33, "min": 0.29, "max": 0.36 },
    "envelope_m": { "length": [3.8, 5.2], "width": [1.60, 2.00], "height": [0.80, 1.10] }
  },

  "mass": {
    "kg": 700,
    "front_weight": 0.44,
    "cog_height_over_track": 0.17,
    "yaw_dynamic_index": 0.85
  },

  "engine": {
    "torque_curve_nm": [[3000, 250], [6000, 340], [9000, 400], [10500, 405], [11000, 391], [12000, 350]],
    "idle_rpm": 3000,
    "redline_rpm": 11800,
    "limiter_rpm": 12000,
    "inertia_kgm2": 0.06,
    "engine_brake_nm": 60
  },
  "gearbox": {
    "type": "sequential",
    "ratios": [3.00, 2.30, 1.85, 1.55, 1.33, 1.17, 1.05],
    "reverse": 3.0,
    "final_drive": 3.00,
    "shift_time_s": 0.04
  },
  "differential": { "type": "lsd_clutch", "preload_nm": 60, "power_lock": 0.40, "coast_lock": 0.25 },
  "brakes": { "max_torque_nm": 7000, "bias_front": 0.56 },
  "suspension": {
    "front": { "freq_hz": 4.0, "damping_bump": 0.60, "damping_rebound": 0.80, "travel_m": 0.03 },
    "rear": { "freq_hz": 3.8, "damping_bump": 0.60, "damping_rebound": 0.80, "travel_m": 0.04 },
    "roll_gradient_deg_per_g": 0.3,
    "roll_stiffness_front_share": 0.53
  },
  "steering": { "max_road_angle_deg": 18, "wheel_rotation_deg": 360 },
  "aero": { "cd_a": 1.10, "cl_a_front": -2.00, "cl_a_rear": -2.60, "slipstream": true },
  "tires": {
    "model": "pacejka_lite",
    "compound": "slick",
    "mu_peak": 1.75,
    "load_sensitivity": 0.12,
    "peak_slip_ratio": 0.08,
    "peak_slip_angle_deg": 6.0,
    "relaxation_length_m": 0.18,
    "rolling_resistance": 0.012,
    "wear": false,
    "temperature": false
  },

  "assists_allowed": ["abs", "tcs", "stability", "auto_gearbox", "auto_clutch", "steer_aid", "racing_line"],
  "damage": { "cosmetic": true, "mechanical": ["alignment", "aero", "suspension"] },

  "tunable": {
    "gearbox.final_drive": { "min": 2.70, "max": 3.40, "step": 0.05 },
    "brakes.bias_front": { "min": 0.50, "max": 0.64, "step": 0.01 },
    "aero.cl_a_front": { "min": -2.40, "max": -1.60, "step": 0.05 },
    "aero.cl_a_rear": { "min": -3.00, "max": -2.20, "step": 0.05 },
    "differential.power_lock": { "min": 0.20, "max": 0.70, "step": 0.05 }
  },

  "ffb": { "reference_rack_nm": 12.0 }
}
