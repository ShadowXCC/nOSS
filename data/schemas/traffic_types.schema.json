{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noss:schema:traffic_types:1",
  "title": "nOSS traffic types",
  "description": "The vehicles highway traffic is made of (D108): each type's model and platform, how common it is, its size, and how it drives in the lane sim. See docs/GAMEMODES.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "types"],
  "properties": {
    "schema": { "const": "noss.traffic_types/1" },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "platform", "length_m", "width_m"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 32 },
          "name": { "type": "string", "maxLength": 32 },
          "model": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 32 },
          "platform": { "type": "string", "pattern": "^official\\.traffic\\.[a-z0-9_]+$|^official\\.highway\\.[a-z0-9_]+$" },
          "weight": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "length_m": { "type": "number", "minimum": 2, "maximum": 20 },
          "width_m": { "type": "number", "minimum": 1, "maximum": 3 },
          "speed_factor": {
            "description": "Desired speed as a share of the limit: [slowest, fastest].",
            "type": "array",
            "prefixItems": [{ "type": "number", "minimum": 0.4, "maximum": 1.4 }, { "type": "number", "minimum": 0.4, "maximum": 1.4 }],
            "minItems": 2,
            "maxItems": 2
          },
          "accel": { "type": "number", "minimum": 0.2, "maximum": 5 },
          "decel": { "type": "number", "minimum": 0.5, "maximum": 6 },
          "headway_s": { "type": "number", "minimum": 0.5, "maximum": 4 },
          "min_gap_m": { "type": "number", "minimum": 1, "maximum": 10 },
          "politeness": { "type": "number", "minimum": 0, "maximum": 1 },
          "lanes_max": { "description": "Keeps to the outermost lanes_max lanes (0: any).", "type": "integer", "minimum": 0, "maximum": 5 },
          "colors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          },
          "patrol": { "description": "Police: patrols when police are on.", "type": "boolean" }
        }
      }
    }
  }
}
