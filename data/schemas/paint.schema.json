{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noss:schema:paint:1",
  "title": "nOSS paint",
  "description": "paint.json inside a .noss package. See docs/VEHICLE_PACKAGE.md §5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slots"],
  "properties": {
    "schema": { "const": "noss.paint/1" },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/slot" },
        "secondary": { "$ref": "#/$defs/slot" },
        "tertiary": { "$ref": "#/$defs/slot" }
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "primary": { "$ref": "#/$defs/color" },
          "secondary": { "$ref": "#/$defs/color" },
          "tertiary": { "$ref": "#/$defs/color" },
          "finish": { "$ref": "#/$defs/finish" }
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "finish": { "enum": ["solid", "metallic", "pearl", "matte", "chrome"] },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "color", "finish"],
      "properties": {
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "color": { "$ref": "#/$defs/color" },
        "finish": { "$ref": "#/$defs/finish" }
      }
    }
  }
}
