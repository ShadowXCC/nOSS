{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noss:schema:mode:1",
  "title": "nOSS mode",
  "description": "A gamemode's classes and the limits it puts on tuning, assists and damage. See docs/PLATFORMS.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "classes"],
  "properties": {
    "schema": { "const": "noss.mode/1" },
    "id": { "enum": ["track", "kart", "highway", "endless", "sumo", "drag"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "classes": {
      "description": "Platform ids the mode offers, in display order.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$" }
    },
    "draft": {
      "description": "Drafting (Track, D208): within range_m behind a car and half_width_m of its line, drag drops by up to drag_cut (more the closer); the car in front of one within lead_range_m loses up to lead_cut. Cars slower than min_speed (m/s) leave no slipstream.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "range_m": { "type": "number", "minimum": 0, "maximum": 200 },
        "half_width_m": { "type": "number", "minimum": 0, "maximum": 5 },
        "drag_cut": { "type": "number", "minimum": 0, "maximum": 0.9 },
        "lead_range_m": { "type": "number", "minimum": 0, "maximum": 50 },
        "lead_cut": { "type": "number", "minimum": 0, "maximum": 0.3 },
        "min_speed": { "type": "number", "minimum": 0, "maximum": 100 },
        "line_cut": { "description": "Pack racing (D228): more drag cut for each car in a line past two.", "type": "number", "minimum": 0, "maximum": 0.2 },
        "line_max": { "type": "integer", "minimum": 0, "maximum": 20 },
        "link_tow": { "description": "How far tucked in (0-1) a car must be to be in the line ahead.", "type": "number", "minimum": 0, "maximum": 1 },
        "side_cut": { "description": "More drag on a car with another alongside at its rear quarter.", "type": "number", "minimum": 0, "maximum": 0.3 },
        "side_gap_m": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "plate": {
      "description": "Restrictor plates (Track, D226): the share of its power each leaves a car.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "light": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "medium": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "heavy": { "type": "number", "minimum": 0.1, "maximum": 1 }
      }
    },
    "police_class": {
      "description": "The platform police drive in this mode (highway: AI only for now).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "Tunable paths the mode allows; [\"*\"] allows all the platform does.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z_]+(\\.[a-z_]+)+)$" }
        }
      }
    },
    "assists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "$ref": "#/$defs/assists" },
        "defaults": { "$ref": "#/$defs/assists" }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cosmetic": { "type": "boolean" },
        "mechanical": { "type": "boolean" }
      }
    },
    "physics_layer": {
      "description": "Arcade layer on top of the core sim (docs/PHYSICS.md §9).",
      "enum": ["none", "kart_arcade"]
    },
    "default_car": {
      "description": "The built-in car its classes start with (res:// folder).",
      "type": "string",
      "pattern": "^res://content/cars/[a-z0-9_]+$"
    },
    "arcade": { "$ref": "#/$defs/arcade" }
  },
  "$defs": {
    "assists": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["abs", "tcs", "stability", "auto_gearbox", "auto_clutch", "steer_aid", "racing_line", "auto_throttle", "brake_assist", "steering_assist", "autodrive", "item_assist"] }
    },
    "pair": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
    "triple": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 10 }, "minItems": 3, "maxItems": 3 },
    "arcade": {
      "description": "The kart_arcade layer's numbers (docs/PHYSICS.md §9, D130-D133). Missing keys take the layer's defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grip": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "steer_aid": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "ref_speed": { "type": "number", "minimum": 5, "maximum": 60 },
            "counter": { "type": "number", "minimum": 0, "maximum": 3 }
          }
        },
        "drift": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "min_speed": { "type": "number", "minimum": 0, "maximum": 30 },
            "min_steer": { "type": "number", "minimum": 0, "maximum": 1 },
            "turn_g": { "$ref": "#/$defs/pair" },
            "slip": { "$ref": "#/$defs/pair" },
            "side_grip": { "type": "number", "minimum": 0, "maximum": 1 },
            "tire_slip": { "type": "number", "minimum": 0, "maximum": 1 },
            "wheel_steer": { "type": "number", "minimum": 0, "maximum": 1 },
            "yaw_accel": { "type": "number", "minimum": 0, "maximum": 50 },
            "hop": { "type": "number", "minimum": 0, "maximum": 3 },
            "exit_s": { "type": "number", "minimum": 0, "maximum": 2 },
            "tiers_s": { "$ref": "#/$defs/triple" },
            "boost_s": { "$ref": "#/$defs/triple" }
          }
        },
        "boost": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "accel": { "type": "number", "minimum": 0, "maximum": 30 },
            "cap": { "type": "number", "minimum": 1, "maximum": 2 },
            "pad_s": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "air": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "pitch": { "type": "number", "minimum": 0, "maximum": 20 },
            "roll": { "type": "number", "minimum": 0, "maximum": 20 },
            "yaw": { "type": "number", "minimum": 0, "maximum": 20 },
            "trick_window_s": { "type": "number", "minimum": 0, "maximum": 2 },
            "trick_boost_s": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "stick": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "min_speed": { "type": "number", "minimum": 0, "maximum": 30 },
            "hold_s": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "right_after_s": { "type": "number", "minimum": 0.2, "maximum": 10 },
        "bounce": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "wall": { "type": "number", "minimum": 0, "maximum": 1 },
            "kart": { "type": "number", "minimum": 0, "maximum": 1 },
            "min_dv": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "land": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "min_fall": { "type": "number", "minimum": 0, "maximum": 50 },
            "rebound": { "type": "number", "minimum": 0, "maximum": 20 },
            "keep": { "type": "number", "minimum": 0, "maximum": 1 },
            "settle_s": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "spin": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "s": { "type": "number", "minimum": 0, "maximum": 5 },
            "grip": { "type": "number", "minimum": 0, "maximum": 1 },
            "yaw_rate": { "type": "number", "minimum": 0, "maximum": 20 },
            "brake": { "type": "number", "minimum": 0, "maximum": 30 }
          }
        },
        "slow": {
          "type": "object", "additionalProperties": false,
          "properties": { "power": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "slipstream": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "range_m": { "type": "number", "minimum": 0, "maximum": 100 },
            "half_width_m": { "type": "number", "minimum": 0, "maximum": 5 },
            "drag_cut": { "type": "number", "minimum": 0, "maximum": 0.9 }
          }
        },
        "tow": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "s": { "type": "number", "minimum": 0.2, "maximum": 5 },
            "speed": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
