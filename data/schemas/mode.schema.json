{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noss:schema:mode:1",
  "title": "nOSS mode",
  "description": "A gamemode's classes and the limits it puts on tuning, assists and damage. See docs/PLATFORMS.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "classes"],
  "properties": {
    "schema": { "const": "noss.mode/1" },
    "id": { "enum": ["track", "kart", "highway", "endless"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 32 },
    "classes": {
      "description": "Platform ids the mode offers, in display order.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$" }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "Tunable paths the mode allows; [\"*\"] allows all the platform does.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z_]+(\\.[a-z_]+)+)$" }
        }
      }
    },
    "assists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "$ref": "#/$defs/assists" },
        "defaults": { "$ref": "#/$defs/assists" }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cosmetic": { "type": "boolean" },
        "mechanical": { "type": "boolean" }
      }
    },
    "physics_layer": {
      "description": "Arcade layer on top of the core sim. kart_arcade arrives in M8.",
      "enum": ["none", "kart_arcade"]
    }
  },
  "$defs": {
    "assists": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["abs", "tcs", "stability", "auto_gearbox", "auto_clutch", "steer_aid", "racing_line"] }
    }
  }
}
