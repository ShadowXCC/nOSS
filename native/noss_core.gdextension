[configuration]

entry_symbol = "noss_core_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://native/bin/libnoss_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libnoss_core.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/bin/libnoss_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libnoss_core.windows.template_release.x86_64.dll"
macos.debug = "res://native/bin/libnoss_core.macos.template_debug.framework"
macos.release = "res://native/bin/libnoss_core.macos.template_release.framework"
