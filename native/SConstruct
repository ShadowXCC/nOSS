#!/usr/bin/env python
# Builds the noss_core GDExtension and its native tests.
#   scons                            debug extension -> native/bin/
#   scons target=template_release    release extension
#   scons tests                      build and run the doctest unit tests

import os

env = SConscript("thirdparty/godot-cpp/SConstruct", {"api_version": "4.7"})


def use_cxx20(e):
    flags = [f for f in e["CXXFLAGS"] if not str(f).startswith(("-std=", "/std:"))]
    flags.append("/std:c++20" if e.get("is_msvc", False) else "-std=c++20")
    e["CXXFLAGS"] = flags


# Extension. Objects go to build/, the library to bin/.
env = env.Clone()
use_cxx20(env)
env.Append(CPPPATH=["src/", "thirdparty/SDL/include/", "thirdparty/meshoptimizer/src/"])
if env["platform"] == "linux":
    env.Append(LIBS=["dl"])
VariantDir("build/src", "src", duplicate=False)
VariantDir("build/meshopt", "thirdparty/meshoptimizer/src", duplicate=False)
sources = Glob("build/src/*.cpp") + Glob("build/src/*/*.cpp") + Glob("build/meshopt/*.cpp")

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libnoss_core.{0}.{1}.framework/libnoss_core.{0}.{1}".format(env["platform"], env["target"]),
        source=sources,
    )
else:
    library = env.SharedLibrary("bin/libnoss_core{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)

env.NoCache(library)
Default(library)

# Native unit tests: plain C++, no Godot dependency. They build every module source except the
# Godot bindings (gd_*.cpp), core/ and input/, plus meshoptimizer.
tests_env = Environment(
    ENV=os.environ, CXX=env["CXX"], CPPPATH=["src/", "thirdparty/doctest/", "thirdparty/meshoptimizer/src/"]
)
tests_env["CXXFLAGS"] = ["/EHsc"] if env.get("is_msvc", False) else ["-Wall", "-Wextra", "-O1"]
use_cxx20(tests_env)
VariantDir("build/tests", "../tests/native", duplicate=False)
VariantDir("build/tests_src", "src", duplicate=False)
VariantDir("build/tests_meshopt", "thirdparty/meshoptimizer/src", duplicate=False)
pure_sources = [
    f for f in Glob("build/tests_src/*/*.cpp") if not f.name.startswith("gd_") and f.dir.name not in ("core", "input")
]
meshopt_objs = [tests_env.Object(f, CXXFLAGS=tests_env["CXXFLAGS"] + ["-w"]) for f in Glob("build/tests_meshopt/*.cpp")]
tests_bin = tests_env.Program("build/tests/noss_core_tests", Glob("build/tests/*.cpp") + pure_sources + meshopt_objs)
AlwaysBuild(Alias("tests", tests_bin, tests_bin[0].abspath))
